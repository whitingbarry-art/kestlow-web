{
  "name": "kestlow-web",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git@github-whitingbarry-art:whitingbarry-art/kestlow-web.git"
  },
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "turbo run storybook",
    "story": "npm run story -w web --",
    "build-storybook": "turbo run build-storybook",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "fix": "prettier --write . && turbo run lint:fix",
    "check": "prettier --check . && turbo run lint typecheck test",
    "check:build": "prettier --check . && turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "test-storybook": "turbo run test-storybook"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
